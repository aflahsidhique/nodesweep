{
  // VS Code runs on Electron and opens .asar files as archives when it watches or
  // indexes them, which locks dist/**/app.asar and breaks `npm run build:win`.
  "files.watcherExclude": {
    "**/dist/**": true,
    "**/out/**": true,
    "**/*.asar": true
  },
  "files.exclude": {
    "dist": true
  },
  "search.exclude": {
    "dist": true,
    "out": true
  }
}
